# Copia a .env (que .gitignore excluye). Ninguna clave va al repositorio: curso/politica-credenciales.md
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QDRANT_URL=http://localhost:6333
# QDRANT_URL=:memory:          # sin Docker: la misma API, sin persistencia
QDRANT_COLLECTION=mmia6013_rag
# Embeddings: h200 (bge-m3, necesita GlobalProtect) · openai (sin VPN, gasta clave) · local (solo Parte 0)
EMBEDDING_BACKEND=h200
H200_EMBED_URL=http://172.28.230.10:11434
# EMBEDDING_MODEL=text-embedding-3-large   # sobreescribe el modelo de la ruta elegida
# GENERATION_MODEL=            # por defecto se decide por la clave disponible (ver rag_pipeline.py)
OLLAMA_URL=http://localhost:11434
# Taller 02: fragmentación del baseline (tokens de bge-m3) y tope de salida de Ollama
CHUNK_TOKENS=512
OVERLAP_TOKENS=128
NUM_PREDICT=512
